  "info": {
    "title": "Jev trader API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/playbook": {
      "get": {
        "operationId": "playbook",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Playbook"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Playbook"
      }
    },
    "/sims": {
      "get": {
        "operationId": "listSims",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimsList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sims"
      }
    },
    "/sims/{sim_id}": {
      "get": {
        "operationId": "simHeader",
        "parameters": [
          {
            "in": "path",
            "name": "sim_id",
            "required": true,
            "schema": {
              "title": "Sim Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimHeader"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sim Header"
      }
    },
    "/sims/{sim_id}/chart": {
      "get": {
        "operationId": "simChart",
        "parameters": [
          {
            "in": "path",
            "name": "sim_id",
            "required": true,
            "schema": {
              "title": "Sim Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sim Chart"
      }
    },
    "/sims/{sim_id}/live": {
      "get": {
        "description": "The quick figures, asked for every second while the sim is in progress.\n\n`after_step`: the last step the page has chart points for; only later ones are sent.",
        "operationId": "simLive",
        "parameters": [
          {
            "in": "path",
            "name": "sim_id",
            "required": true,
            "schema": {
              "title": "Sim Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after_step",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After Step"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveFigures"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sim Live"
      }
    },
    "/sims/{sim_id}/moment": {
      "get": {
        "description": "The account, its positions, and the trades around one moment.\n\n`at`: a real time, UTC. The moment is the step that ended at or just before it.",
        "operationId": "simMoment",
        "parameters": [
          {
            "in": "path",
            "name": "sim_id",
            "required": true,
            "schema": {
              "title": "Sim Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "at",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "At",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moment"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sim Moment"
      }
    },
    "/spending": {
      "get": {
        "operationId": "spending",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Spending"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Spending"
      }
    },
    "/spending/total": {
      "get": {
        "operationId": "spendingTotal",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpendingTotal"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Spending Total"
      }
    }
  }
}
