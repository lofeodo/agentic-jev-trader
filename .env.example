# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Twelve Data (stock price data). Key from the free Basic plan: https://twelvedata.com/account/api-keys
# The free plan is for personal, non-commercial use, and its terms require deleting the downloaded
# data if the account is closed. Crypto price data comes from Binance's public files and needs no key.
TWELVE_DATA_API_KEY=

# TypeSafe AI (Jev, the decision model that picks and sizes trades). Key from https://console.typesafe.ai/keys
# Billed per use: about $0.04 per million tokens read, so a 3-month run costs a few dollars.
# The official SDK reads this exact variable name.
TYPESAFE_API_KEY=

# Anthropic (the LLM that selects which past episodes Jev is shown).
# Key from the API keys page of the Anthropic Console: https://console.anthropic.com
# Billed per use: about $0.10 per million tokens read and $0.50 per million written, so a 3-month
# run costs roughly $2 to $10. The official SDK reads this exact variable name.
ANTHROPIC_API_KEY=

# Z.ai (GLM-5.3-Flash, the second LLM in the benchmark that runs before any actual run).
# Key from the API keys page of Z.ai: https://z.ai/manage-apikey/apikey-list
# Billed per use from credit loaded in advance: about $0.15 per million tokens read and $0.50 per
# million written, so the benchmark's 50 full evaluations cost well under $1.
ZAI_API_KEY=

# Postgres on AWS RDS (the database that holds every dataset, sim and memory). Each program logs in as its own
# role with a password: no key files. The address comes from Terraform once the database exists
# (infra/README.md). Connections are encrypted; the local Postgres in Docker that the database
# tests use has no encryption, so set POSTGRES_SSL_MODE=disable for it.
POSTGRES_HOST=
# Optional. Default 5432.
POSTGRES_PORT=
# Optional. Default require (encrypted connections only).
POSTGRES_SSL_MODE=
# One password per login: the dataset builder, the sim, the memory server (can only read), the
# API, and the setup login that makes the tables. Pick a long random one for each.
POSTGRES_BUILDER_PASSWORD=
POSTGRES_SIM_PASSWORD=
POSTGRES_MEMORY_PASSWORD=
POSTGRES_API_PASSWORD=
POSTGRES_SETUP_PASSWORD=
# The admin login RDS makes with the database (trading_agent_admin). Only infra/rds.py uses it,
# to make the five logins, the two databases and pgvector. Pick a long random one too; after
# changing it, see infra/README.md (Postgres on AWS RDS).
POSTGRES_ADMIN_PASSWORD=

# AWS budget alarm (infra/rds.py): the address that gets an email once a month's AWS bill passes
# $5. AWS itself is reached with the AWS CLI's login on this computer (`aws sso login`), not a key
# in this file.
AWS_BUDGET_EMAIL=

# LangSmith (records traces of the agent's work). Free Developer plan, no card on file, so it
# cannot bill. Key from https://smith.langchain.com/settings. Set LANGSMITH_TRACING to true once
# the key is in. Tracing is always off in tests. The share of full evaluations traced, by sim
# kind, is in config/tracing.toml. Traces go to the LangSmith project named here.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-jev-trader

# How the API starts jobs (a sim, a dataset build): `local` starts a program on this machine,
# `kubernetes` starts a Job in the local kind cluster.
JOB_LAUNCHER=local
