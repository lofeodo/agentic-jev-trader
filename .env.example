# Copy this file to .env and fill in the values. .env is never committed.
#
# Variable names are PROVISIONAL: foundation S2 (config model) confirms or renames them.
# Providers and the Snowflake sign-in method were settled in foundation S1
# (decisions FND-007 to FND-013). See docs/configuration.md.

# --- Snowflake -------------------------------------------------------------------------
# Account identifier, e.g. <orgname>-<accountname>
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=TRADING_AGENT
SNOWFLAKE_WAREHOUSE=
# One service user per role, signing in with a key pair (FND-013: service users cannot
# use a password); the value is the path to the user's private key file.
# Agent job and MCP servers: AGENT_ROLE
SNOWFLAKE_AGENT_USER=
SNOWFLAKE_AGENT_PRIVATE_KEY_PATH=
# Dataset build job: BUILDER_ROLE
SNOWFLAKE_BUILDER_USER=
SNOWFLAKE_BUILDER_PRIVATE_KEY_PATH=
# API: APP_ROLE
SNOWFLAKE_APP_USER=
SNOWFLAKE_APP_PRIVATE_KEY_PATH=
# Administrator used only by Terraform and the migration runner
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=

# --- LLM: DeepSeek (FND-007) -----------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# --- Jev decision model, TypeSafe AI (FND-008) ---------------------------------------------
# For the OpenRouter fallback: JEV_API_URL=https://openrouter.ai/api and an OpenRouter key.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.14.0

# --- LangSmith tracing (FND-012) -------------------------------------------------------
# Traces are sent only when LANGSMITH_TRACING=true and a key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-jev-trader
LANGSMITH_TRACING=false

# --- Market data (FND-009) ---------------------------------------------------------------
# Stocks and funds: Alpaca free plan (paper-only account), key ID and secret.
# Crypto: Coinbase Exchange public API, no key needed.
STOCK_DATA_API_KEY=
STOCK_DATA_API_SECRET=
