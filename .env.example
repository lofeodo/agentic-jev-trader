# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Alpaca (stock price data). Keys from a free Alpaca practice account, which Alpaca calls a
# "paper only account": it holds pretend money (for example a fake $100,000 balance) and never
# touches real dollars. Used here only to download price data: https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Twelve Data (fallback stock price data). Key from the free Basic plan: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=

# TypeSafe AI (Jev, the decision model that picks and sizes trades). Key from https://console.typesafe.ai/keys
# Billed per use: about $0.04 per million tokens read, so a 3-month run costs a few dollars.
# The official SDK reads this exact variable name.
TYPESAFE_API_KEY=

# Anthropic (the LLM that selects which past episodes Jev is shown).
# Key from the API keys page of the Anthropic Console: https://console.anthropic.com
# Billed per use: about $0.10 per million tokens read and $0.50 per million written, so a 3-month
# run costs roughly $2 to $10. The official SDK reads this exact variable name.
ANTHROPIC_API_KEY=
