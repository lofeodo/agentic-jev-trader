# Copy this file to .env and fill in the values. .env is never committed.
#
# Variable names are PROVISIONAL: foundation S2 (config model) confirms or renames them,
# and S1/S4 settle the Snowflake authentication method. See docs/configuration.md.

# --- Snowflake -------------------------------------------------------------------------
# Account identifier, e.g. <orgname>-<accountname>
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=TRADING_AGENT
SNOWFLAKE_WAREHOUSE=
# One service user per role. Key-pair authentication is assumed (service users cannot
# sign in with a password); the value is the path to the user's private key file.
# Agent job and MCP servers: AGENT_ROLE
SNOWFLAKE_AGENT_USER=
SNOWFLAKE_AGENT_PRIVATE_KEY_PATH=
# Dataset build job: BUILDER_ROLE
SNOWFLAKE_BUILDER_USER=
SNOWFLAKE_BUILDER_PRIVATE_KEY_PATH=
# API: APP_ROLE
SNOWFLAKE_APP_USER=
SNOWFLAKE_APP_PRIVATE_KEY_PATH=
# Administrator used only by Terraform and the migration runner
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=

# --- LLM (provider and model chosen in foundation S1) -----------------------------------
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Jev decision model (TypeSafe AI) -----------------------------------------------------
JEV_API_KEY=
JEV_API_URL=

# --- LangSmith tracing (tracing is a no-op when the key is empty) ---------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-jev-trader
LANGSMITH_TRACING=false

# --- Market data providers (chosen in foundation S1) --------------------------------------
STOCK_DATA_API_KEY=
CRYPTO_DATA_API_KEY=
