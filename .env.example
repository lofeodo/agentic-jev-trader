# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Twelve Data (stock price data). Key from the free Basic plan: https://twelvedata.com/account/api-keys
# The free plan is for personal, non-commercial use, and its terms require deleting the downloaded
# data if the account is closed. Crypto price data comes from Binance's public files and needs no key.
TWELVE_DATA_API_KEY=

# TypeSafe AI (Jev, the decision model that picks and sizes trades). Key from https://console.typesafe.ai/keys
# Billed per use: about $0.04 per million tokens read, so a 3-month run costs a few dollars.
# The official SDK reads this exact variable name.
TYPESAFE_API_KEY=

# Anthropic (the LLM that selects which past episodes Jev is shown).
# Key from the API keys page of the Anthropic Console: https://console.anthropic.com
# Billed per use: about $0.10 per million tokens read and $0.50 per million written, so a 3-month
# run costs roughly $2 to $10. The official SDK reads this exact variable name.
ANTHROPIC_API_KEY=

# Z.ai (GLM-5.3-Flash, the second LLM in the benchmark that runs before any actual run).
# Key from the API keys page of Z.ai: https://z.ai/manage-apikey/apikey-list
# Billed per use from credit loaded in advance: about $0.15 per million tokens read and $0.50 per
# million written, so the benchmark's 50 full evaluations cost well under $1.
ZAI_API_KEY=
