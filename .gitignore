# Secrets: real keys live only in .env (see .env.example)
.env

# Private keys never enter the repo
*.p8
*.pem

# Terraform: providers are downloaded per checkout; state lives outside the repo
# (in ~/.agentic-jev-trader, see infra/README.md), and is ignored here in case one lands.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Copies of the database saved by `python -m jev_trader.storage save` (Parquet or pg_dump)
saved-tables/

# Copies of GitHub issues an agent saves before a large tracker edit (see RESTORE.md inside)
issue-backups/

# Python and tool caches
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Package build leftovers (pip wheel, pip install)
build/

# The web app's installed packages and build output
node_modules/
web/dist/

# Logs the Playwright browser tools write while an agent drives a browser
.playwright-mcp/

# What the sims' jobs print when the API starts them
logs/
