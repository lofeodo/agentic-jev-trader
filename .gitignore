# Secrets: real keys live only in .env (see .env.example)
.env

# Snowflake private keys never enter the repo
*.p8
*.pem

# Terraform: providers are downloaded per checkout; state lives outside the repo
# (SNOWFLAKE_LOCAL_DIR, see infra/README.md), and is ignored here in case one lands.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Python and tool caches
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Package build leftovers (pip wheel, pip install)
build/
